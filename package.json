{
  "name": "acme-widget-co",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "elitecoderdev — Luis Jimenez",
    "email": "devs@elitecoders.cl",
    "url": "https://github.com/elitecoderdev"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @acme/api --filter @acme/web dev",
    "build": "pnpm --filter @acme/web build && pnpm --filter @acme/api build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --configLoader native",
    "test:coverage": "vitest run --coverage --configLoader native",
    "test:e2e": "playwright test",
    "test:security": "node scripts/security-smoke.mjs",
    "check": "pnpm typecheck && pnpm test:coverage && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
